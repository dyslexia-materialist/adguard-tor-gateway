# ==== AGGuard gateway config ====
# cp config/gateway.env.example config/gateway.env → değerleri doldur
# (gateway.env .gitignore'da — ASLA commit edilmez)

# AdGuard Home (tunnel-internal IP):
AGH_DNS="10.10.0.1"
AGH_QUERYLOG="/opt/adguardhome/work/data/querylog.json"

# İSS zehir testi:
TT_RESOLVER="203.0.113.10"        # İSS'in zehirli çözücüsü
CLEAN_DNS="1.1.1.1"
POISON_IPS="192.0.2.1 192.0.2.2"  # zehirli cevap IP'leri (boşlukla ayrı)

# Keenetic router:
KEEN_HOST="192.168.0.1"           # router SSH (LAN veya tünel içi)
KEEN_PASSFILE="/etc/secure/keenpass"  # şifre dosyası (chmod 600 — repo'ya ASLA)
KEEN_IFACE="Wireguard0"           # trafik WG arayüz adı

# Tor/redsocks:
REDIR_PORT="12345"
SOCKS_PORT="9050"
MSS="1240"

# Loglar/listeler:
ADDED_LOG="/opt/agguard/added.log"
BANNED_LIST="/opt/agguard/banned.txt"
